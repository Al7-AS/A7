# ---------------------------------------------------------------
# LearnSphere environment variables
# Copy to .env.local for development. NEVER commit real values.
# Only variables prefixed with NEXT_PUBLIC_ reach the browser.
# ---------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Database (PostgreSQL, Supabase or self-hosted)
DATABASE_URL=postgres://learnsphere:change_me@localhost:5432/learnsphere
# Server-only. Used by the app's service role for background jobs. Never expose.
DATABASE_SERVICE_ROLE_URL=

# Authentication
# Random 32+ byte secret used to sign session tokens (JWT via jose).
AUTH_SECRET=replace_with_32_plus_random_bytes
SESSION_TTL_HOURS=168
PASSWORD_HASH_ROUNDS=12

# Email (transactional: verification, password reset, notifications)
EMAIL_PROVIDER=smtp
EMAIL_FROM="LearnSphere <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Storage (Supabase Storage or any S3-compatible bucket)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=learnsphere-uploads
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
NEXT_PUBLIC_STORAGE_HOST=

# Payments - integration interfaces only.
# No transaction is marked successful without a verified webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Live sessions (Zoom or another provider)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# WhatsApp Business API (prepared, not required)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Redis (optional: caching and background jobs)
REDIS_URL=

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
